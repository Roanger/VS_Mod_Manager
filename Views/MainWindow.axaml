<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSModManager.ViewModels"
        x:Class="VSModManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VS Mod Manager"
        Width="1100" Height="700" MinWidth="800" MinHeight="400">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="Gray" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#11FFFFFF" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="16,12" Background="#1AFFFFFF">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding GameVersionText}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ModsDir}" Foreground="Gray" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Open Mods Folder" Command="{Binding OpenModsFolderCommand}" />
          <Button Content="Backups" Command="{Binding OpenBackupsFolderCommand}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Classes="accent" Command="{Binding UpdateAllCommand}">
            <TextBlock>
              <Run Text="Update All (" /><Run Text="{Binding UpdatesAvailable}" /><Run Text=")" />
            </TextBlock>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="16,6" Background="#1AFFFFFF">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- Column headers -->
    <Border DockPanel.Dock="Top" Classes="row">
      <Grid ColumnDefinitions="44,*,100,100,220,290">
        <TextBlock Classes="header" Text="On" />
        <TextBlock Classes="header" Grid.Column="1" Text="Mod" />
        <TextBlock Classes="header" Grid.Column="2" Text="Installed" />
        <TextBlock Classes="header" Grid.Column="3" Text="Latest" />
        <TextBlock Classes="header" Grid.Column="4" Text="Status" />
      </Grid>
    </Border>

    <!-- Mod list -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Mods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModItemViewModel">
            <Border Classes="row">
              <Grid ColumnDefinitions="44,*,100,100,220,290">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                          ToolTip.Tip="Enable or disable this mod (same list as the in-game mod screen)" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding FileNames}"
                            Opacity="{Binding RowOpacity}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ModId}" Foreground="Gray" FontSize="12" />
                  <TextBlock Text="{Binding DuplicateText}" Foreground="Orange" FontSize="12"
                             IsVisible="{Binding IsDuplicate}" />
                  <TextBlock Text="{Binding DependencyText}" Foreground="IndianRed" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding HasDependencyIssues}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" VerticalAlignment="Center"
                           Opacity="{Binding RowOpacity}" />
                <TextBlock Grid.Column="3" Text="{Binding LatestVersion}" VerticalAlignment="Center"
                           Opacity="{Binding RowOpacity}" />
                <TextBlock Grid.Column="4" Opacity="{Binding RowOpacity}" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Content="Fix Dependencies" Command="{Binding FixDependenciesCommand}"
                          IsVisible="{Binding HasFixableDependencies}"
                          IsEnabled="{Binding !IsInstallingDependencies}" />
                  <Button Content="Fix Duplicates" Command="{Binding RemoveDuplicatesCommand}"
                          IsVisible="{Binding IsDuplicate}" />
                  <Button Content="Page" Command="{Binding OpenPageCommand}"
                          IsVisible="{Binding HasPage}" />
                  <Button Content="Update" Classes="accent" Command="{Binding UpdateCommand}"
                          IsVisible="{Binding CanUpdate}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
