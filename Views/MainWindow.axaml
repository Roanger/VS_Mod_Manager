<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSModManager.ViewModels"
        x:Class="VSModManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VS Mod Manager"
        Width="1100" Height="700" MinWidth="800" MinHeight="400">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="Gray" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#11FFFFFF" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="16,12" Background="#1AFFFFFF">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding GameVersionText}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ModsDir}" Foreground="Gray" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Open Mods Folder" Command="{Binding OpenModsFolderCommand}" />
          <Button Content="Backups" Command="{Binding OpenBackupsFolderCommand}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Content="⚙ Settings" Click="Settings_Click" />
          <Button Classes="accent" Command="{Binding UpdateAllCommand}">
            <TextBlock>
              <Run Text="Update All (" /><Run Text="{Binding UpdatesAvailable}" /><Run Text=")" />
            </TextBlock>
          </Button>
          <Button Content="{Binding PlayText}" Command="{Binding PlayCommand}"
                  Background="SeaGreen" Foreground="White" FontWeight="SemiBold" MinWidth="100"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Profiles -->
    <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Profile" VerticalAlignment="Center" Foreground="Gray" />
        <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}"
                  MinWidth="200" ToolTip.Tip="Switching applies that profile's enabled/disabled mods" />
        <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
        <Border Width="1" Background="#33FFFFFF" Margin="8,4" />
        <TextBox Text="{Binding NewProfileName}" Watermark="New profile name" Width="200" />
        <Button Content="Save As New" Command="{Binding CreateProfileCommand}"
                ToolTip.Tip="Creates a profile from the current enabled/disabled mods" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="16,6" Background="#1AFFFFFF">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- Search and filter -->
    <Border DockPanel.Dock="Top" Padding="16,8,16,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox Classes="clearButton" Text="{Binding SearchText}"
                 Watermark="Search mods by name, ID or author…" />
        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130"
                  ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}"
                  ToolTip.Tip="Updates: newer version available · Problems: dependency issues, duplicates or errors" />
        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                   Text="{Binding VisibleCountText}" />
      </Grid>
    </Border>

    <!-- Column headers -->
    <Border DockPanel.Dock="Top" Classes="row">
      <Grid ColumnDefinitions="44,*,100,100,220,300">
        <TextBlock Classes="header" Text="On" />
        <TextBlock Classes="header" Grid.Column="1" Text="Mod" />
        <TextBlock Classes="header" Grid.Column="2" Text="Installed" />
        <TextBlock Classes="header" Grid.Column="3" Text="Latest" />
        <TextBlock Classes="header" Grid.Column="4" Text="Status" />
      </Grid>
    </Border>

    <!-- Mod list -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Mods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModItemViewModel">
            <Border Classes="row" IsVisible="{Binding MatchesFilter}">
             <StackPanel>
              <Grid ColumnDefinitions="44,*,100,100,220,300">
                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                          ToolTip.Tip="Enable or disable this mod (same list as the in-game mod screen)" />
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Opacity="{Binding RowOpacity}">
                <Border Width="48" Height="48" CornerRadius="6" ClipToBounds="True"
                        Background="#18FFFFFF" VerticalAlignment="Top" Margin="0,2,12,0">
                  <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding FileNames}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ModId}" /><Run Text="{Binding ByAuthor}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#B0B0B0"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasSummary}" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding DuplicateText}" Foreground="Orange" FontSize="12"
                             IsVisible="{Binding IsDuplicate}" />
                  <TextBlock Text="{Binding DependencyText}" Foreground="IndianRed" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding HasDependencyIssues}" />
                </StackPanel>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" VerticalAlignment="Center"
                           Opacity="{Binding RowOpacity}" />
                <TextBlock Grid.Column="3" Text="{Binding LatestVersion}" VerticalAlignment="Center"
                           Opacity="{Binding RowOpacity}" />
                <TextBlock Grid.Column="4" Opacity="{Binding RowOpacity}" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <WrapPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <WrapPanel.Styles>
                    <Style Selector="Button"><Setter Property="Margin" Value="3" /></Style>
                  </WrapPanel.Styles>
                  <Button Content="Fix Dependencies" Command="{Binding FixDependenciesCommand}"
                          IsVisible="{Binding HasFixableDependencies}"
                          IsEnabled="{Binding !IsInstallingDependencies}" />
                  <Button Content="Fix Duplicates" Command="{Binding RemoveDuplicatesCommand}"
                          IsVisible="{Binding IsDuplicate}" />
                  <Button Content="{Binding ChangelogButtonText}" Command="{Binding ToggleChangelogCommand}"
                          IsVisible="{Binding HasChangelog}" />
                  <Button Content="Page" Command="{Binding OpenPageCommand}"
                          IsVisible="{Binding HasPage}" />
                  <Button Content="Update" Classes="accent" Command="{Binding UpdateCommand}"
                          IsVisible="{Binding CanUpdate}" />
                </WrapPanel>
              </Grid>
              <Border IsVisible="{Binding IsChangelogOpen}" Margin="44,8,0,4" Padding="12,10"
                      Background="#14FFFFFF" CornerRadius="6" MaxHeight="320">
                <ScrollViewer>
                  <SelectableTextBlock Text="{Binding ChangelogText}" TextWrapping="Wrap" FontSize="13" />
                </ScrollViewer>
              </Border>
             </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
